{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": true,
    "types": []
  },
  "//": "The checking program: src plus the stories and the Storybook config, so a broken story is a type error rather than something discovered in a browser. tsconfig.build.json is the emitting program and is deliberately narrower.",
  "include": ["src", ".storybook"]
}
