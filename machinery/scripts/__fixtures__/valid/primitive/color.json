{
  "color": {
    "$type": "color",
    "$description": "Raw ramps. Literal values only, no aliases.",
    "neutral": {
      "0": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#ffffff" }
      },
      "100": {
        "$value": { "colorSpace": "srgb", "components": [0.94, 0.94, 0.94], "alpha": 1, "hex": "#f0f0f0" }
      },
      "400": {
        "$value": { "colorSpace": "srgb", "components": [0.55, 0.55, 0.55], "alpha": 1, "hex": "#8c8c8c" }
      },
      "500": {
        "$value": { "colorSpace": "srgb", "components": [0.5, 0.5, 0.5], "alpha": 1 }
      },
      "600": {
        "$value": { "colorSpace": "srgb", "components": [0.4, 0.4, 0.4], "alpha": 1, "hex": "#666666" }
      },
      "900": {
        "$value": { "colorSpace": "srgb", "components": [0.18, 0.18, 0.18], "alpha": 1, "hex": "#2e2e2e" }
      },
      "1000": {
        "$value": { "colorSpace": "srgb", "components": [0.06, 0.06, 0.06], "alpha": 1, "hex": "#0f0f0f" }
      }
    },
    "accent": {
      "500": {
        "$value": { "colorSpace": "srgb", "components": [0.1, 0.35, 0.2], "alpha": 1 }
      }
    }
  }
}
