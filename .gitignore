# dependencies
node_modules/

# build output
dist/
build/
.vite/

# token build intermediate — the adapted JSON machinery/scripts/dtcg-adapt.mjs
# hands to Style Dictionary. Regenerated by every build, read by nothing else.
# Goes when dtcg-adapt.mjs goes.
#
# packages/tokens/ is deliberately NOT ignored: the generated CSS, Swift and XML
# are committed. They are a future npm package, they are what a reviewer reads
# to see what a token change actually did, and the build is deterministic, so a
# rebuild that produces a diff is a signal rather than noise.
.tokens-build/

# environment
.env
.env.*
!.env.example

# os
.DS_Store

# editor
.vscode/
.idea/

# logs
*.log
npm-debug.log*

# unrelated local assets — not part of Mizan
BlaBlaCar ios May 2026/

# Agent worktrees — transient, and each is its own git repo.
.claude/worktrees/
